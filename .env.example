# Copy to .env.local and fill in from your Supabase project
# (Project Settings -> API). Both are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Optional. Invite links derive from the incoming request, so this is only
# needed when the public URL differs from the request host (e.g. behind a
# proxy or a custom domain that rewrites Host).
# NEXT_PUBLIC_SITE_URL=https://klasshub.ng

# Never put the service_role / secret key in a NEXT_PUBLIC_ variable — it would
# be shipped to the browser and bypasses RLS entirely.

# Shared secret for the public contact form. The browser never calls the
# contact Edge Function directly — this server forwards the message, and this
# header is what proves the call came from us. Server-only, so no NEXT_PUBLIC_
# prefix. Must match the CONTACT_SECRET function secret set below. Unset, the
# form refuses to send rather than pretending to have sent.
CONTACT_SECRET=

# ---------------------------------------------------------------------------
# Email and SMS
#
# These do NOT belong in this file. The sending worker is a Supabase Edge
# Function, not the Next.js app, so its credentials live as function secrets
# where the browser bundle can never reach them:
#
#   supabase secrets set BREVO_API_KEY=xkeysib-...
#   supabase secrets set TERMII_API_KEY=TL...
#   supabase secrets set DISPATCH_SECRET="$(openssl rand -hex 32)"
#   supabase secrets set MAIL_FROM=no-reply@yourdomain.ng
#   supabase secrets set MAIL_FROM_NAME="Your School"
#   supabase secrets set TERMII_SENDER_ID=YourSenderID   # optional, defaults to N-Alert
#
# The public contact form is a separate Edge Function and needs three more.
# CONTACT_SECRET must equal the CONTACT_SECRET above; CONTACT_IP_SALT is what
# keeps the stored IP hashes from being brute-forced back into addresses, so it
# belongs here and not in the database:
#
#   supabase secrets set CONTACT_SECRET="<the same value as CONTACT_SECRET above>"
#   supabase secrets set CONTACT_TO=hello@yourdomain.ng
#   supabase secrets set CONTACT_IP_SALT="$(openssl rand -hex 32)"
#
# Until the provider keys exist the pipeline still runs end to end and marks
# every message 'skipped' with the reason, visible under Settings.
#
# Paystack is the same story — the secret key belongs to the Edge Functions,
# never to Next.js, because it can move money:
#
#   supabase secrets set PAYSTACK_SECRET_KEY=sk_test_...
#
# There is deliberately no NEXT_PUBLIC_PAYSTACK_* key. Checkout is opened
# server-side and the browser only ever receives the resulting Paystack URL.
# ---------------------------------------------------------------------------
